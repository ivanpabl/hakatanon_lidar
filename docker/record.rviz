# Копия rviz/tunnel_od.rviz для записи видео (docker/record.sh): окно 1600x900 без боковой
# панели, вид из-за кабины вдоль пути, точки крупнее. Для интерактивной работы -- tunnel_od.rviz.
Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 30
      Color: 160; 160; 164
      Alpha: 0.12
      Reference Frame: <Fixed Frame>
      Value: true
    # Облако: в записях топик называется по-разному, включены оба (работает тот, что есть)
    - Class: rviz_default_plugins/PointCloud2
      Name: Cloud /lidar_points
      Enabled: true
      Topic:
        Value: /lidar_points
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds: false
      Min Value: -2
      Max Value: 4
      Decay Time: 0
      Queue Size: 1
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Cloud /sensing/lidar/hesai128/pointcloud
      Enabled: true
      Topic:
        Value: /sensing/lidar/hesai128/pointcloud
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds: false
      Min Value: -2
      Max Value: 4
      Decay Time: 0
      Queue Size: 1
      Value: true
    # Ось пути (зелёная), коридор (синий), объекты (красные -- тревога), текст с дистанцией
    - Class: rviz_default_plugins/MarkerArray
      Name: tunnel_od markers
      Enabled: true
      Topic:
        Value: /tunnel_od/markers
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Namespaces:
        tunnel_od: true
        tunnel_od_text: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 36
    # frame_id облака: hesai_lidar (5 записей), lidar_livox (doubleT_obstacle).
    # Для doubleT_obstacle: rviz2 -d tunnel_od.rviz -f lidar_livox
    Fixed Frame: hesai_lidar
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      # Вид сзади-сверху вдоль пути: вперёд -- это -y
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 32
      Focal Point:
        X: 0
        Y: -30
        Z: 0
      Pitch: 0.16
      Yaw: 1.5708
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1600
  Hide Left Dock: true
  Displays:
    collapsed: false

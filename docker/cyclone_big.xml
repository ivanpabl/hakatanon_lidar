<?xml version="1.0" encoding="UTF-8"?>
<!-- CycloneDDS: обмен большими кадрами (8-23 МБ) через loopback с большими буферами.
     Нужен net.core.rmem_max >= 64 МБ (docker run --sysctl net.core.rmem_max=...). -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces><NetworkInterface name="lo"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Internal>
      <SocketReceiveBufferSize min="64MB"/>
      <Watermarks><WhcHigh>64MB</WhcHigh></Watermarks>
    </Internal>
    <Discovery><ParticipantIndex>auto</ParticipantIndex><Peers><Peer address="localhost"/></Peers></Discovery>
  </Domain>
</CycloneDDS>
